# Copie este arquivo para ".env" e preencha. NUNCA envie o .env para o GitHub.

# Endereço público do site (usado nos links dos e-mails)
BASE_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# Uma frase longa e aleatória (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=troque-isto-por-um-texto-aleatorio-bem-grande

# Conta que envia os e-mails de confirmação
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=botsitecaeb@gmail.com
# Para Gmail: NÃO é a senha normal da conta. É uma "Senha de app" de 16 letras (veja o README)
SMTP_PASS=

# Domínio obrigatório dos e-mails de cadastro
EMAIL_DOMAIN=ufpr.br

# Tamanho máximo de cada arquivo enviado (MB)
MAX_UPLOAD_MB=300

# Em produção (NODE_ENV=production) o login só funciona com HTTPS.
# Se for testar em produção SEM https, descomente a linha abaixo:
# COOKIE_SECURE=false

# Pasta onde ficam o banco de dados e os arquivos enviados (padrão: ./data)
# DATA_DIR=/data
