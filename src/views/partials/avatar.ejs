<% const _s = locals.size || 40; %><% if (a.avatar) { %><img class="avatar" src="/uploads/<%= a.avatar %>" alt="Foto de <%= a.username %>" width="<%= _s %>" height="<%= _s %>" style="width:<%= _s %>px;height:<%= _s %>px"><% } else { %><span class="avatar avatar-letter" style="width:<%= _s %>px;height:<%= _s %>px;font-size:<%= Math.round(_s * 0.45) %>px" aria-hidden="true"><%= (a.username || '?').trim().charAt(0).toUpperCase() %></span><% } %>